# MemoryVerse AI - Backend Authentication Configuration
# Rename this file to '.env' and fill in your API credentials to enable real-time verification.

# Google OAuth Configuration (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Twilio SMS Configuration (from Twilio Console)
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-token-here
TWILIO_PHONE_NUMBER=your-twilio-phone-number-here

# Google Gemini API (For AI Document Extraction and Smart Chatbot RAG)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API (For Realtime Voice Assistant)
OPENAI_API_KEY=your-openai-api-key-here
